// {{ notice }}
#pragma once

#include <array>
#include <string_view>

namespace dross::generated {

enum class SchemaKind {
  command,
  event,
  rule,
};

struct SchemaRegistryEntry {
  std::string_view stable_id;
  std::string_view name;
  SchemaKind kind;
  unsigned int version;
};

inline constexpr std::array schema_registry{
{% for schema in catalog %}
    SchemaRegistryEntry{.stable_id = "{{ schema.stable_id }}",
                        .name = "{{ schema.name }}",
                        .kind = SchemaKind::{{ schema.kind }},
                        .version = {{ schema.version }}U},
{% endfor %}
};

inline constexpr std::array command_registry{
{% for schema in catalog if schema.kind == "command" %}
    std::string_view{"{{ schema.stable_id }}"},
{% endfor %}
};

} // namespace dross::generated
